{
  "manifest_version": 3,
  "name": "文字捕獲工具",
  "version": "1.0.2",
  "description": "捕獲 ChatGPT 等動態渲染頁面的對話文字，支援批量掃描與側邊閱讀模式",
  "icons": {
    "16":  "icons/CaptureText_icon_16.png",
    "48":  "icons/CaptureText_icon.png",
    "128": "icons/CaptureText_icon_128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/CaptureText_icon_16.png",
      "48": "icons/CaptureText_icon.png"
    },
    "default_title": "文字捕獲工具"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js":  ["content/content.js"],
    "css": ["content/content.css"],
    "run_at": "document_idle"
  }],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"]
}
